# Пример настроек. Скопируй несекретное в .env, секретное в .env.local

# --- .env (несекретное) ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
SERVER_URL=http://127.0.0.1:8000
CELL_SIZE=32
GRID_COLS=20
GRID_ROWS=15
DATABASE_PATH=game.db

# --- .env.local (секреты) ---
TELEGRAM_BOT_TOKEN=PUT_YOUR_TOKEN_HERE
